        "d3-delaunay": "^6.0.6",
        "express": "^5.3.0",
        "express-session": "^1.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "jsdoc": "^4.0.5",
        "prettier": "^3.10.1",
        "vitest": "^5.1.0"
    }
