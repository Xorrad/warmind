    "description": "A motivational website made as a project for university.",
    "main": "server/index.js",
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "test": "vitest run",
        "start": "node --env-file-if-exists=.env server/index.js",
        "dev": "node --env-file-if-exists=.env --watch server/index.js",
