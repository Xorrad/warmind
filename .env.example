# Copy to .env (never commit .env). Read by `npm start` / `npm run dev`.
PORT=3000
DB_PATH=data/warmind.db
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=
# production: secure (HTTPS-only) cookies, SESSION_SECRET required
NODE_ENV=development
# 1 when running behind a reverse proxy (client IPs for rate limits, secure cookies)
TRUST_PROXY=0
